  "cards": [
    {
      "dot": "emerald",
      "title": "Two Independent Cortex Calls",
      "items": [
        "Call 1 proposes skills plus self-scored GPA (context relevance, groundedness, answer relevance)",
        "Call 2 independently fact-checks every candidate against that skill's full documented scope; only its reason text reaches the report",
        "Snowflake AIM bypasses both calls -- pinned first, unconditionally, when a supported legacy source is detected"
      ]
    },
    {
      "dot": "violet",
      "title": "Catalog Is the Only Trusted Vocabulary",
      "items": [
        "Deterministic candidates are filtered to the 111 real skills in COCO_SKILLS.md before the first Cortex call ever sees them",
        "Legacy non-catalog names are dropped outright, never aliased to a similar catalog entry"
      ]
    },
    {
      "dot": "amber",
      "title": "Part 1 No Longer Grounds Skills",
      "items": [
        "The narrative only reads account names -- it never displays skill chips or rationale",
        "A per-use-case Cortex call that computed unused skill data was removed as dead code"
      ]
    }
  ]
}