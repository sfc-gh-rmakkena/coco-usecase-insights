  "cards": [
    {
      "dot": "emerald",
      "title": "LLM-as-Judge: Four Match Types",
      "items": [
        "A second, independent Cortex call fact-checks every candidate -- current-state, named-tool replacement, greenfield build, or stated-outcome match",
        "Candidates are filtered to the 111 real skills in COCO_SKILLS.md first; Snowflake AIM bypasses the judge entirely when detected"
      ]
    },
    {
      "dot": "violet",
      "title": "GPA Framework",
      "items": [
        "Each candidate self-scores context relevance, groundedness, and answer relevance (0.0-1.0) at discovery time",
        "Combined score is a product (CR x GR x AR); a coverage floor rescues the best candidate instead of zero skills"
      ]
    },
    {
      "dot": "cyan",
      "title": "32-Way Parallel REST Dispatch",
      "items": [
        "ThreadPoolExecutor(max_workers=32) fans discovery and judge calls out across every use case concurrently",
        "Each worker calls the Cortex Messages REST API directly, with exponential backoff retry on HTTP 429"
      ]
    }
  ]
